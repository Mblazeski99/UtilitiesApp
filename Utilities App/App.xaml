<Application x:Class="UtilitiesApp.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:UtilitiesApp.ViewModels"
             xmlns:views="clr-namespace:UtilitiesApp.Views"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/Theme.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <DataTemplate DataType="{x:Type vm:RenamerViewModel}">
                <views:RenamerView />
            </DataTemplate>

            <DataTemplate DataType="{x:Type vm:YouTubeViewModel}">
                <views:YouTubeView />
            </DataTemplate>
        </ResourceDictionary>
    </Application.Resources>
</Application>
