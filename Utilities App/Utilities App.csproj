<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <RootNamespace>UtilitiesApp</RootNamespace>
    <AssemblyName>UtilitiesApp</AssemblyName>
    <Product>Utilities App</Product>
    <ApplicationIcon>Utilities-App-Icon.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="Utilities-App-Icon.ico" />
  </ItemGroup>

</Project>
