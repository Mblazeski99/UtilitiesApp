<Window x:Class="UtilitiesApp.MainWindow"
        Title="Utilities App"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        Background="#1e1e1e"
        FontSize="20"
        mc:Ignorable="d">

    <Grid HorizontalAlignment="Center" Margin="20">

        <StackPanel>

            <Label Content="Enter name for the files" 
                   FontSize="28" 
                   Width="600" />

            <TextBox TextChanged="FileNameTextBox_TextChanged"
                     x:Name="FileNameTextBox"
                     Margin="0 20 0 0" 
                     Width="600" />

            <Label Content="Enter the extension for the file" 
                   FontSize="28" 
                   Width="600" />
            
            <TextBox TextChanged="ExtensionTextBox_TextChanged"
                     x:Name="ExtensionTextBox"
                     Margin="0 20 0 0" 
                     Text=".jpg"
                     Width="600" />

            <Label Content="Examples:" 
                   Margin="0 20 0 0" 
                   Width="600" />
            
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Label x:Name="Examples1" />
                <Label x:Name="Examples2" Margin="20 0 0 0" />
                <Label x:Name="Examples3" Margin="20 0 0 0" />
            </StackPanel>

            <Button Click="SelectFileButton_Click"
                    Content="Select file directory" 
                    Margin="0 20 0 0" />

        </StackPanel>

    </Grid>
    
</Window>
