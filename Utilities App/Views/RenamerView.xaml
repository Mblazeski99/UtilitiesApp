<UserControl x:Class="UtilitiesApp.Views.RenamerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
        <Border MaxWidth="680"
                HorizontalAlignment="Left"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="16"
                Padding="28">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="File name" Style="{StaticResource FieldLabel}" />
                        <TextBox Text="{Binding FileName, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Extension" Style="{StaticResource FieldLabel}" />
                        <TextBox Text="{Binding Extension, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                </Grid>

                <TextBlock Text="Preview"
                           Style="{StaticResource FieldLabel}"
                           Margin="2,22,0,8" />

                <WrapPanel>
                    <Border Background="{StaticResource SurfaceRaisedBrush}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="10,6"
                            Margin="0,0,8,8">
                        <TextBlock Text="{Binding Example1}" />
                    </Border>
                    <Border Background="{StaticResource SurfaceRaisedBrush}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="10,6"
                            Margin="0,0,8,8">
                        <TextBlock Text="{Binding Example2}" />
                    </Border>
                    <Border Background="{StaticResource SurfaceRaisedBrush}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="10,6"
                            Margin="0,0,8,8">
                        <TextBlock Text="{Binding Example3}" />
                    </Border>
                </WrapPanel>

                <TextBlock Text="Files in the chosen folder are renamed in place, starting at 1."
                           Style="{StaticResource HintText}"
                           Margin="2,4,0,0" />

                <Button Content="Choose folder and rename"
                        Command="{Binding SelectFolderCommand}"
                        Style="{StaticResource PrimaryButton}"
                        HorizontalAlignment="Left"
                        Margin="0,22,0,0" />
            </StackPanel>
        </Border>
    </ScrollViewer>

</UserControl>
