<UserControl x:Class="UtilitiesApp.Views.RenamerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">

    <Grid>
        <StackPanel Width="600"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">

            <Label Content="Enter name for the files"
                   FontSize="28"
                   Width="600" />

            <TextBox Text="{Binding FileName, UpdateSourceTrigger=PropertyChanged}"
                     Margin="0 20 0 0"
                     Width="600" />

            <Label Content="Enter the extension for the file"
                   FontSize="28"
                   Width="600" />

            <TextBox Text="{Binding Extension, UpdateSourceTrigger=PropertyChanged}"
                     Margin="0 20 0 0"
                     Width="600" />

            <Label Content="Examples:"
                   Margin="0 20 0 0"
                   Width="600" />

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Label Content="{Binding Example1}" />
                <Label Content="{Binding Example2}" Margin="20 0 0 0" />
                <Label Content="{Binding Example3}" Margin="20 0 0 0" />
            </StackPanel>

            <Button Command="{Binding SelectFolderCommand}"
                    Content="Select file directory"
                    Margin="0 20 0 0" />

        </StackPanel>
    </Grid>

</UserControl>
